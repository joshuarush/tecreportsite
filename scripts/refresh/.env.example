# Armadollar refresh pipeline configuration.
# Copy to .env next to tec_refresh.py (or set TEC_BASE_DIR to the dir holding .env).
# Never commit the real .env.

# --- Cloudflare R2 (S3 API) credentials for rclone ---
# Create at: Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create token
# (Object Read & Write, scoped to the tec-data bucket). The dashboard shows the
# Access Key ID / Secret Access Key pair and your account id.
RCLONE_CONFIG_R2TEC_TYPE=s3
RCLONE_CONFIG_R2TEC_PROVIDER=Cloudflare
RCLONE_CONFIG_R2TEC_ACCESS_KEY_ID=your-access-key-id
RCLONE_CONFIG_R2TEC_SECRET_ACCESS_KEY=your-secret-access-key
RCLONE_CONFIG_R2TEC_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# rclone remote:bucket to upload into (matches the R2TEC remote above)
TEC_R2_REMOTE=r2tec:tec-data

# --- Optional tuning ---
# TEC_DUCKDB_MEMORY=4GB
# TEC_DUCKDB_THREADS=4
# TEC_WORK_DIR=/path/with/lots/of/space
# TEC_BIN_DIR=/share/CACHEDEV1_DATA/armadollar-refresh/bin  # extra dir searched for duckdb/rclone
